# Local development: copy to .env (npm run dev reads it). All keys are optional except one RPC URL.

# ---- chains: every chain with an RPC URL is scanned ----
RPC_URL_ETHEREUM=https://ethereum-rpc.publicnode.com
# RPC_URL_BASE=
# RPC_URL_ARBITRUM=
# RPC_URL_OPTIMISM=
# Blocks to wait before reporting (defaults: ethereum 3, base 10, optimism 10, arbitrum 20)
# CONFIRMATIONS_ETHEREUM=3
# Chains searched for text messages in transactions; empty turns messages off
MESSAGES_CHAINS=ethereum
# POLL_INTERVAL_MS=4000
# MAX_BLOCKS_PER_TICK=50
# Further behind than this (after downtime), old blocks are skipped
# MAX_LAG_BLOCKS=1000

# ---- enrichment: third-party APIs, both optional ----
# Dollar amounts from DefiLlama (coins.llama.fi)
# PRICES=true
# Names of unknown methods from the openchain signature database
# SIGNATURE_LOOKUP=true

# ---- Telegram: without a token notifications are only logged ----
BOT_TOKEN=
# polling (default) or webhook
BOT_MODE=polling
# BOT_WEBHOOK_URL=https://bot.example.com
# BOT_WEBHOOK_SECRET=   # openssl rand -hex 32
# Telegram user ids allowed to run /stats
BOT_ADMINS=
# MAX_WATCHES_PER_CHAT=20

# ---- storage: without MongoDB everything is kept in memory (required with NODE_ENV=production) ----
# MONGO_URI=mongodb://localhost:27017/eth-watch

# ---- HTTP ----
PORT=3000
LOG_LEVEL=info
# Origins allowed to call GET /v1/messages from a browser, comma separated
# CORS_ORIGINS=
# Proxy hops in front of the app (1 behind Caddy)
# TRUST_PROXY=0

# ---- chat of the old bots, set up on start ----
# DEFAULT_CHANNEL_ID=-100…
# DEFAULT_ADDRESSES=0x…,0x…
# DEFAULT_CHANNEL_MESSAGES=false
