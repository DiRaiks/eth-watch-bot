# Copy to <DEPLOY_PATH>/.env on the VPS. Never commit the real file.

# ---- compose ----
# Profiles to run next to the bot: web (Caddy with HTTPS), mongo (local MongoDB with backups)
# COMPOSE_PROFILES=web,mongo
# Public domain for the web profile; Caddy gets the TLS certificate
# DOMAIN=bot.example.com
# BACKUP_KEEP_DAYS=14
# Database the mongo profile backs up: the one in MONGO_URI (mongodb://mongo:27017/<MONGO_DB>)
# MONGO_DB=eth-watch
# Image tag of mongo and mongo-backup
# MONGO_VERSION=8.0.34

# ---- chains (all keys: ../.env.example) ----
# Comma-separated URLs are tried in order, the next one when a request fails
RPC_URL_ETHEREUM=
# RPC_URL_BASE=
# RPC_URL_ARBITRUM=
# RPC_URL_OPTIMISM=
# RPC_URL= is the legacy name of RPC_URL_ETHEREUM, used when that one is not set
MESSAGES_CHAINS=ethereum

# ---- enrichment: third-party APIs, both optional ----
# Dollar amounts from DefiLlama (coins.llama.fi)
# PRICES=true
# Names of unknown methods from the openchain signature database
# SIGNATURE_LOOKUP=true

# ---- Telegram ----
BOT_TOKEN=
BOT_MODE=polling
# Webhook mode needs the web profile and DOMAIN:
# BOT_MODE=webhook
# BOT_WEBHOOK_URL=https://bot.example.com
# BOT_WEBHOOK_SECRET=
BOT_ADMINS=

# ---- storage ----
# Atlas: mongodb+srv://user:password@cluster.example.mongodb.net/eth-watch
# Local profile: mongodb://mongo:27017/eth-watch
MONGO_URI=

# ---- HTTP (web profile) ----
# PORT is ignored here: compose always runs the bot on 3000
# HOST=0.0.0.0
TRUST_PROXY=1
# CORS_ORIGINS=https://example.com
LOG_LEVEL=info

# ---- chat of the old bots ----
# DEFAULT_CHANNEL_ID=
# Each address is added once; one removed with /unwatch stays removed after a restart
# DEFAULT_ADDRESSES=
# DEFAULT_CHANNEL_MESSAGES=false
