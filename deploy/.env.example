# Copy to <DEPLOY_PATH>/.env on the VPS. Never commit the real file.

# ---- compose ----
# Profiles to run next to the bot: web (Caddy with HTTPS), mongo (local MongoDB with backups)
# COMPOSE_PROFILES=web,mongo
# Public domain for the web profile; Caddy gets the TLS certificate
# DOMAIN=bot.example.com
# BACKUP_KEEP_DAYS=14

# ---- chains (all keys: ../.env.example) ----
RPC_URL_ETHEREUM=
# RPC_URL_BASE=
# RPC_URL_ARBITRUM=
# RPC_URL_OPTIMISM=
MESSAGES_CHAINS=ethereum

# ---- Telegram ----
BOT_TOKEN=
BOT_MODE=polling
# Webhook mode needs the web profile and DOMAIN:
# BOT_MODE=webhook
# BOT_WEBHOOK_URL=https://bot.example.com
# BOT_WEBHOOK_SECRET=
BOT_ADMINS=

# ---- storage ----
# Atlas: mongodb+srv://user:password@cluster.example.mongodb.net/eth-watch
# Local profile: mongodb://mongo:27017/eth-watch
MONGO_URI=

# ---- HTTP (web profile) ----
TRUST_PROXY=1
# CORS_ORIGINS=https://example.com
LOG_LEVEL=info

# ---- chat of the old bots ----
# DEFAULT_CHANNEL_ID=
# DEFAULT_ADDRESSES=
# DEFAULT_CHANNEL_MESSAGES=false
